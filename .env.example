# ============================================================
# PLANTILLA de entorno para docker-compose.
#     cp .env.example .env
# .env esta en .gitignore y NO debe subirse.
# (Fuera de Docker se usa secrets.properties: ver secrets.properties.example)
# ============================================================

# --- Oracle (tu instalacion local) ---
DB_HOST=host.docker.internal:1521
DB_SERVICE=XEPDB1
DB_CLIENTE_PASSWORD=cambia-esto
DB_EMPLEADO_PASSWORD=cambia-esto
DB_INTEGRACION_PASSWORD=cambia-esto

# --- Sesion (JWT propio) ---
# Obligatorio, minimo 32 caracteres. Generar uno:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Vida del token en milisegundos (7200000 = 2 horas)
JWT_EXPIRATION_MS=7200000
# Audiencia del token (para quien es). Igual en todos los entornos de la misma app.
JWT_AUDIENCE=ecomers-web

# --- Wompi (sandbox: pub_test_..., test_integrity_..., test_events_...) ---
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=http://localhost:5173/pedidos/{idPedido}/resultado

# --- Imagenes de producto (Supabase Storage; opcional) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=productos

# --- App ---
HOST_PORT=8080
# Detras de un proxy o balanceador: native (lee la IP real del cliente). Sin proxy: none
FORWARD_HEADERS_STRATEGY=none
# Limites por minuto: por IP en toda la API, por IP en registro/login y por usuario autenticado
RATE_LIMIT_POR_MINUTO=120
RATE_LIMIT_AUTH_POR_MINUTO=10
RATE_LIMIT_USUARIO_POR_MINUTO=100
# Origenes exactos del frontend, separados por coma: http(s)://dominio[:puerto], sin ruta, sin barra final y sin *
CORS_ALLOWED_ORIGINS=http://localhost:5173
# false si otra instancia ya consume la cola o si no hay SMTP disponible
COLA_HABILITADA=true
# true solo en desarrollo: publica Swagger (por defecto esta apagado)
API_DOCS_HABILITADO=true
