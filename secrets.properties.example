# ============================================================
# PLANTILLA de secretos. Copia este archivo a secrets.properties
# y rellena los valores reales:
#     cp secrets.properties.example secrets.properties
# secrets.properties esta en .gitignore y NO debe subirse.
#
# En produccion define estas claves como variables de entorno
# (tienen prioridad sobre el archivo).
# ============================================================

# Claves de los tres usuarios de aplicacion de Oracle (scripts 01 y 01b).
# Nunca la del duenio ECOMERS: la API no se conecta con el.
DB_CLIENTE_PASSWORD=cambia-esto
DB_EMPLEADO_PASSWORD=cambia-esto
DB_INTEGRACION_PASSWORD=cambia-esto

# Firma de los tokens de sesion (JWT). OBLIGATORIO, minimo 32 caracteres, aleatorio y distinto por entorno.
# Generar uno:  openssl rand -base64 48
# Si cambia, todas las sesiones abiertas dejan de servir.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Imagenes de producto en Supabase Storage (opcional para arrancar; sin esto no se pueden subir imagenes).
# SUPABASE_URL: la URL del proyecto, sin barra final (https://<ref>.supabase.co).
# SUPABASE_SERVICE_KEY: la clave de servicio (service_role / secret). SOLO servidor: jamas en el frontend.
# SUPABASE_BUCKET: bucket PUBLICO donde caen las fotos (por defecto "productos").
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=productos

# Wompi (opcional para arrancar). Llaves del panel de comercio (sandbox: pub_test_..., test_integrity_..., test_events_...).
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Desarrollo: publica Swagger en /swagger-ui.html (por defecto esta apagado).
API_DOCS_HABILITADO=true
